;; A Seatbelt profile under which a desktop app (kitty) opened its window, tested on
;; macOS 27 (design/macos.md, Desktop apps): deny by default, the home closed but the
;; zone's own, no network. @HOME@ and @ZONE_HOME@ stand for the user's home and the zone's.
(version 1)
(deny default)
(allow process-exec process-fork)
(allow signal (target self))
(allow file-read* file-map-executable)
(deny file-read* (subpath "@HOME@"))
(allow file-read* (literal "@HOME@"))
(allow file-read* file-write* (subpath "@ZONE_HOME@"))
(allow file-read* file-write* (subpath "/private/var/folders") (subpath "/private/tmp") (literal "/dev/null") (literal "/dev/tty"))
(allow sysctl-read)
(allow mach-lookup)
(allow ipc-posix-shm)
(allow iokit-open)
(allow user-preference-read)
(allow pseudo-tty)
(allow file-read* file-write* file-ioctl (literal "/dev/ptmx") (regex #"^/dev/ttys[0-9]+$"))
(allow mach-register)
(allow process-info* (target self))
(allow distributed-notification-post)
(allow ipc-posix-sem)
(allow system-fsctl)
(allow file-ioctl (literal "/dev/null"))
(allow ipc*) (allow process-info*) (allow iokit*)
(allow sysctl-write) (allow file-ioctl) (allow file-test-existence)
(deny file-test-existence (subpath "@HOME@")) (allow file-test-existence (literal "@HOME@") (subpath "@ZONE_HOME@"))
