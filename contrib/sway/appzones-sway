#!/bin/sh
# appzones-sway: mark every sway window by the app zone its process runs in
# (appzones docs/desktop.md; tested in tests/distro-test.sh). Start it from the sway
# config: `exec /usr/share/appzones/contrib/sway/appzones-sway` (or this file's path).
#
# The zone comes from what cannot be changed from inside a zone, never from the window's
# title or app_id, which the app chooses:
# - the window's security context (sway 1.11 and later): engine "dev.mirql.zones" and app
#   id "dev.mirql.zone.NAME", which appzones' zone-wayland sets on the host (a zone's
#   clients never see the security-context manager, so cannot make their own);
# - its process's cgroup, .../appzones.slice/appzones@NAME.service (also a cgroup below
#   it), which systemd sets and a zone process cannot leave.
# If both are there they must agree. Fails closed: another sandbox's security context, a
# process under appzones.slice that is not a zone's unit, a nested pid namespace (a zone
# sway 1.9 cannot name, or another sandbox), or an unreadable pid: "zone:?".
#
# A zone window gets the mark "zone:NAME:ID" (a sway mark names one window), the title
# prefix "[NAME]", and
# `shortcuts_inhibitor disable` (zone clients can see
# zwp_keyboard_shortcuts_inhibit_manager_v1; they never switch off sway's shortcuts).
# Sway has no per-window border colour; marks show in the title bar with `show_marks yes`.
#
# The work is `appzones _sway-marks` (helper/src/active.rs); this file only finds it:
# the appzones installed with it (PREFIX/share/appzones/contrib/sway -> PREFIX/bin), else
# the one on $PATH. Only from an installed layout: run from a checkout, the same relative
# path could name any file (~/bin/appzones), which nothing vouches for.
here=$(dirname "$(readlink -f "$0")") || exit 1
case "$here" in
  */share/appzones/contrib/sway)
    own="${here%/share/appzones/contrib/sway}/bin/appzones"
    [ -x "$own" ] && exec "$own" _sway-marks ;;
esac
exec appzones _sway-marks
